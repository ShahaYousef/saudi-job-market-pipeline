    "jobAd": {
      "sections": {
        "companyDescription": {
          "title": "Company Description",
          "text": "<p>Do you want beneficial technologies being shaped by your ideas? Whether in the areas of mobility solutions, consumer goods, industrial technology or energy and building technology - with us, you will have the chance to improve quality of life all across the globe. Welcome to Bosch.</p>"
        },
        "jobDescription": {
          "title": "Job Description",
          "text": "<p><strong>Business Unit:</strong> Software and Digital Solutions</p><p>Are you passionate about Artificial Intelligence, Cloud Computing, and next-gen technology?<br>\nWe’re looking for ambitious students or recent graduates who are eager to kickstart their careers in one of the most in-demand fields in the world.</p><p>As a <strong>Software Development Intern</strong>, you’ll gain hands-on experience with cutting-edge tools, work alongside industry experts, and contribute to real-world projects that impact businesses across the region.</p><p>During your internship, you will:</p><ul><li>Design and deploy scalable applications on cloud platforms</li><li>Explore AI/ML models, data pipelines, and automation workflows</li><li>Assist in developing intelligent cloud-native solutions that drive innovation</li><li>Collaborate with cross-functional teams on digital transformation projects</li><li>Learn DevOps practices, cloud security, and performance optimization</li></ul>"
        },
        "qualifications": {
          "title": "Qualifications",
          "text": "<ul><li>University students or recent graduates in Computer Science, Software Engineering, AI, Data Science, or related fields</li><li>Passionate about technology, innovation, and continuous learning</li><li>Familiar with basic programming (Python, Java, or C#)&#xa0;</li><li>Knowledgeable in cloud fundamentals or AI concepts is a plus</li><li>Excellent problem-solvers and communicators</li><li>Fluent in Arabic and English</li></ul>"
        },
        "additionalInformation": {
          "title": "Additional Information",
          "text": ""
        }
      }
    }
