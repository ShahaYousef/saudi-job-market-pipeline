# .env.example
# Template only. Copy it to .env (git-ignored) and put your own values there, never here.
# The pre-commit hook "env-example-placeholders-only" rejects this file if it holds a real key:
#   pip install pre-commit && pre-commit install

# Aggregator API keys, comma-separated when you have several
JOOBLE_API_KEYS=<jooble-key>
JSEARCH_API_KEYS=<jsearch-key-1>,<jsearch-key-2>

# ADLS upload (pipeline/landing/upload_to_adls.py)
# SAS scoped to the raw container, with Read, Add, Create, Write and List, no leading "?"
ADLS_ACCOUNT_NAME=<storage-account-name>
ADLS_CONTAINER=raw
ADLS_SAS_TOKEN=<container-sas-token>

# Snowflake login, read by dbt/profiles.yml through env_var() (see dbt/profiles.example.yml)
SNOWFLAKE_ACCOUNT=<orgname-accountname>
SNOWFLAKE_USER=<your-user>
SNOWFLAKE_PASSWORD=<your-password>
