    "jobAd": {
      "sections": {
        "companyDescription": {
          "title": "Company Description",
          "text": "<p>Do you want beneficial technologies being shaped by your ideas? Whether in the areas of mobility solutions, consumer goods, industrial technology or energy and building technology - with us, you will have the chance to improve quality of life all across the globe. Welcome to Bosch.</p>"
        },
        "jobDescription": {
          "title": "Job Description",
          "text": "<p><strong>Business Unit:</strong> Software and Digital Solutions</p><p>Are you a strategic thinker with a passion for business, sales, and Technology?<br>\nJoin us as a <strong>Business Management Intern</strong> in our Presales and Sales Operations team — and gain hands-on experience driving business growth and supporting cutting-edge digital solutions.</p><p>As a Business Management Intern, you’ll work closely with our sales, marketing, and technical experts, helping shape go-to-market strategies for Cloud, AI, and digital transformation services that empower organizations across Saudi Arabia.</p><p>During your internship, you will:</p><ul><li>Support the Presales team in preparing client proposals, presentations, and RFP documentation</li><li>Conduct market research and analyze customer needs to support solution positioning</li><li>Assist in tracking sales performance, KPIs, and pipeline management using CRM tools</li><li>Collaborate with cross-functional teams (marketing, finance, operations) to streamline sales processes</li><li>Help design sales enablement materials, such as product sheets and value propositions</li></ul>"
        },
        "qualifications": {
          "title": "Qualifications",
          "text": "<ul><li>Students or recent graduates in Business Administration, Management, Marketing or Finance</li><li>Strong communicators with analytical and organizational skills</li><li>Proficient in Microsoft Office Suite (especially Excel and PowerPoint</li><li>Eager to learn in a fast-paced, collaborative, and tech-driven environment</li><li>Fluent in Arabic and English</li></ul>"
        },
        "additionalInformation": {
          "title": "Additional Information",
          "text": ""
        }
